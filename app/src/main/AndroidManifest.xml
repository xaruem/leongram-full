<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- нужно, чтобы видеть копию Instagram с любым именем пакета (приложение B) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <queries>
        <package android:name="com.instagram.android"/>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".SetupActivity" android:exported="false"/>
        <activity android:name=".AccountsActivity" android:exported="false"/>
        <activity android:name=".ScheduleActivity" android:exported="false"/>
        <activity android:name=".StatsActivity" android:exported="false"/>
        <activity android:name=".ScreensActivity" android:exported="false"/>

        <service
            android:name=".BotService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config"/>
        </service>
    </application>
</manifest>
